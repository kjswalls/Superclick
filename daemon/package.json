{
  "name": "superclick-daemon",
  "version": "0.2.0",
  "private": true,
  "description": "Superclick's local daemon: holds requests and their context for the Mac app; hosts the coordinator and agent sessions from M2.",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --compile --outfile ../build/superclick-daemon"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322"
  }
}
